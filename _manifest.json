{
  "manifest_version": 2,
  "id": "Sanchess.deepseek-search",
  "name": "DeepSeek 联网搜索",
  "version": "1.0.0",
  "description": "通过 DeepSeek Search/Fetch 接口为 Planner 与 VLM 提供联网搜索和网页抓取工具，支持普通/增强双模式，增强模式下会主动督促 Planner/VLM 调用搜索核实事实",
  "author": {
    "name": "Sanchess",
    "url": "https://github.com/rayafriandion"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://api-docs.deepseek.com/zh-cn/api/search",
    "homepage": "https://api-docs.deepseek.com/zh-cn/guides/search"
  },
  "host_application": {
    "min_version": "1.2.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "send.text"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
